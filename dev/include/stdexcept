#include <exception>
#include <string>

namespace std {

typedef basic_string<char> __cow_string;

class logic_error : public exception {
  const char* message_;

public:
  explicit logic_error(const string& message);
  explicit logic_error(const char* message) : message_(message) {}
  logic_error(const logic_error& other) : exception(other), message_(other.message_) {}
  virtual ~logic_error() {}
  virtual const char* what() const { return message_; }
};

class domain_error : public logic_error {
public:
  explicit domain_error(const string& message);
  explicit domain_error(const char* message) : logic_error(message) {}
  domain_error(const domain_error& other) : logic_error(other) {}
  virtual ~domain_error() {}
};

class invalid_argument : public logic_error {
public:
  explicit invalid_argument(const string& message);
  explicit invalid_argument(const char* message) : logic_error(message) {}
  invalid_argument(const invalid_argument& other) : logic_error(other) {}
  virtual ~invalid_argument() {}
};

