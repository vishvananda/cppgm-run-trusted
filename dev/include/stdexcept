public:
  explicit length_error(const string& message);
  explicit length_error(const char* message) : logic_error(message) {}
  length_error(const length_error& other) : logic_error(other) {}
  virtual ~length_error() {}
};

class out_of_range : public logic_error {
public:
  explicit out_of_range(const string& message);
  explicit out_of_range(const char* message) : logic_error(message) {}
  out_of_range(const out_of_range& other) : logic_error(other) {}
  virtual ~out_of_range() {}
};

