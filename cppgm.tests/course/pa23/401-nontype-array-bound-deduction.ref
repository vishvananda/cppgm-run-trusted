function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $buf : obj<5x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $buf
    %t2 = call ptr @keep_array_bound(%t1)
    %t3 = addr $buf
    %t4 = unary decay ptr %t3
    %t5 = cmp eq ptr %t2, %t4
