int depth = 0;

struct Guard
{
  int& ref;
  Guard(int& r) : ref(r) { ++ref; }
  ~Guard() { --ref; }
};

int f()
{
  for (int i = 0; i < 3; ++i)
  {
    Guard guard(depth);
    if (i == 0)
      continue;
    return depth;
  }
  return depth;
}

int main()
{
  int value = f();
  if (value != 1)
    return 10 + value;
  if (depth != 0)
    return 20 + depth;
  return 0;
}
