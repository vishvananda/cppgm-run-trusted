function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $i : i32
  slot $n : i32

  block ^entry:
    store i32 0, $i
    store i32 0, $n
    jump ^while_cond_1

  block ^while_cond_1:
    %t1 = load i32 $i
    %t2 = cmp lt i32 %t1, 3
    branch %t2, ^while_body_2, ^while_end_3

  block ^while_body_2:
    %t3 = load i32 $i
    %t4 = binary add i32 %t3, 1
    store i32 %t4, $i
    %t5 = load i32 $i
    jump ^switch_dispatch_4

  block ^switch_dispatch_4:
    switch %t5, ^switch_default_7, 1:^switch_case_6

  block ^switch_case_6:
    jump ^while_cond_1

  block ^switch_default_7:
    %t6 = load i32 $n
    %t7 = binary add i32 %t6, 1
    store i32 %t7, $n
    jump ^switch_end_5

  block ^switch_end_5:
    %t8 = load i32 $n
    %t9 = binary add i32 %t8, 10
    store i32 %t9, $n
    jump ^while_cond_1

  block ^while_end_3:
    %t10 = load i32 $n
    return i32 %t10
}
