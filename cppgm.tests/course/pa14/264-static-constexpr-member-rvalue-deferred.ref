    return i32 %t1
}
function @read_address() -> i32 [binding=weak, object=_Z12read_addressILb1EEiv] {
  slot $p : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr @flag_true___value
    store ptr %t1, $p
    %t2 = load ptr $p
    %t3 = load u8 %t2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 7, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 11, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load i32 $cond__1
